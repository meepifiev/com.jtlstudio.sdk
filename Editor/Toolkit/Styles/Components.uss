.jtl-root .jtl-mr-6 { margin-right: 6px; }
.jtl-root .jtl-mr-8 { margin-right: 8px; }
.jtl-root .jtl-mr-10 { margin-right: 10px; }
.jtl-root .jtl-mr-12 { margin-right: 12px; }

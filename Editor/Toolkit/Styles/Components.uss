}

.jtl-root .jtl-number-field--disabled {
    opacity: 0.4;
    background-color: var(--jtl-field-bg-disabled);
}

.jtl-root .jtl-search {
    flex-shrink: 0;
}

.jtl-root .jtl-search__icon {
    margin-right: 6px;
}

.jtl-root .jtl-search__input {
    flex-grow: 1;
    flex-shrink: 1;

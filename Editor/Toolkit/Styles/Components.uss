    border-color: var(--jtl-border-strong);
    background-color: var(--jtl-switch-off);
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.jtl-root .jtl-switch__knob {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: var(--jtl-switch-knob-off);
    margin-left: 0;
    transition-property: margin-left, background-color;
    transition-duration: 0.12s;
}

.jtl-root .jtl-switch:hover {
    border-color: var(--jtl-border-hover);
}

.jtl-root .jtl-switch:focus {

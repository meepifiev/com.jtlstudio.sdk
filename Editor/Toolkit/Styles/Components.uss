.jtl-root .jtl-pt-4 { padding-top: 4px; }

.jtl-icon {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--jtl-text-secondary);
}

.jtl-icon--secondary {
    -unity-background-image-tint-color: var(--jtl-text-secondary);
}

.jtl-icon--muted {
    -unity-background-image-tint-color: var(--jtl-text-muted);
}

.jtl-icon--text {
    -unity-background-image-tint-color: var(--jtl-text);
}

.jtl-icon--accent {
    -unity-background-image-tint-color: var(--jtl-accent);
}

.jtl-icon--success {
    -unity-background-image-tint-color: var(--jtl-success);
}

.jtl-icon--warning {
    -unity-background-image-tint-color: var(--jtl-warning);
}

.jtl-icon--error {
    -unity-background-image-tint-color: var(--jtl-error);
}

.jtl-icon--on-accent {
    -unity-background-image-tint-color: var(--jtl-text-on-accent);
}

.jtl-root .jtl-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 30px;
    min-height: 30px;
    padding: 0 14px;
    margin: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--jtl-border);
    background-color: var(--jtl-raised);
    color: var(--jtl-text);
    font-size: 13px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.jtl-root .jtl-button__label {
    font-size: 13px;
    color: var(--jtl-text);
    -unity-text-align: middle-center;
}

.jtl-root .jtl-button__icon {
    margin-right: 6px;
}

.jtl-root .jtl-button__trailing {
    margin-left: 6px;
}

.jtl-root .jtl-button:hover {
    background-color: var(--jtl-raised-hover);
    border-color: var(--jtl-border-strong);
}

.jtl-root .jtl-button:active {
    background-color: var(--jtl-raised-pressed);
    border-color: var(--jtl-border);
}

.jtl-root .jtl-button:focus {
    border-color: var(--jtl-accent);
}

.jtl-root .jtl-button:disabled {
    opacity: 0.4;
}


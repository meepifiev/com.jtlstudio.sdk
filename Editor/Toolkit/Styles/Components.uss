}

.jtl-root .jtl-checkbox__label {
    font-size: 13px;
    color: var(--jtl-text);
}

.jtl-root .jtl-checkbox:hover .jtl-checkbox__box {
    border-color: var(--jtl-border-hover);
}

.jtl-root .jtl-checkbox:focus .jtl-checkbox__box {
    border-color: var(--jtl-accent);
}

.jtl-root .jtl-checkbox--checked .jtl-checkbox__box {
    background-color: var(--jtl-accent-strong);
    border-color: var(--jtl-accent-strong-border);
}

.jtl-root .jtl-checkbox--checked .jtl-checkbox__mark {
    opacity: 1;
}

.jtl-root .jtl-checkbox:disabled {
    opacity: 0.4;
}

.jtl-root .jtl-radio-group {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.jtl-root .jtl-radio {
    flex-direction: row;
    align-items: center;
}

.jtl-root .jtl-radio__circle {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--jtl-border-strong);
    background-color: var(--jtl-field-bg);
    align-items: center;
    justify-content: center;
    margin-right: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.jtl-root .jtl-radio__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--jtl-text-on-accent);
    opacity: 0;
}

.jtl-root .jtl-radio__label {
    font-size: 13px;
    color: var(--jtl-text);
}

.jtl-root .jtl-radio:hover .jtl-radio__circle {
    border-color: var(--jtl-border-hover);
}

.jtl-root .jtl-radio:focus .jtl-radio__circle {
    border-color: var(--jtl-accent);
}

.jtl-root .jtl-radio--selected .jtl-radio__circle {
    background-color: var(--jtl-accent-strong);
    border-color: var(--jtl-accent-strong-border);
}

.jtl-root .jtl-radio--selected .jtl-radio__dot {
    opacity: 1;
}

.jtl-root .jtl-check-row {
    flex-direction: row;
    align-items: center;
    height: 26px;
    min-height: 26px;
}

.jtl-root .jtl-check-row__icon {
    margin-right: 8px;
}

.jtl-root .jtl-check-row__text {
    font-size: 12px;
    color: var(--jtl-text);
    white-space: normal;
}

.jtl-root .jtl-check-row--pending .jtl-check-row__text,
.jtl-root .jtl-check-row--warning .jtl-check-row__text {
    color: var(--jtl-text-secondary);
}

.jtl-root .jtl-message {
    flex-direction: row;
    align-items: center;
}

.jtl-root .jtl-message__icon {
    margin-right: 6px;
}

.jtl-root .jtl-message__text {
    font-size: 11px;
    white-space: normal;
}

.jtl-root .jtl-message--error .jtl-message__text {
    color: var(--jtl-error);
}

.jtl-root .jtl-message--warning .jtl-message__text {
    color: var(--jtl-warning);
}

.jtl-root .jtl-message--info .jtl-message__text {
    color: var(--jtl-text-muted);
}

.jtl-root .jtl-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    border-width: 1px;
    border-color: var(--jtl-border-strong);
    border-radius: 14px;
    flex-grow: 1;
}

.jtl-root .jtl-empty--plain {
    border-width: 0;
    padding: 0;
}

.jtl-root .jtl-empty__icon {
    margin-bottom: 8px;
}

.jtl-root .jtl-empty__title {
    font-size: 13px;
    color: var(--jtl-text);
    margin-bottom: 8px;
}

.jtl-root .jtl-empty__description {
    font-size: 11px;
    color: var(--jtl-text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 320px;
    margin-bottom: 8px;
}

.jtl-root .jtl-empty__actions {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.jtl-root .jtl-section-header {
    flex-direction: row;
    align-items: flex-start;
}

.jtl-root .jtl-section-header__text {
    flex-grow: 1;
    flex-direction: column;
    margin-right: 12px;
    min-width: 0;
}

.jtl-root .jtl-section-header__title {
    font-size: 21px;
    -unity-font-style: bold;
    color: var(--jtl-text);
    letter-spacing: -0.3px;
}

.jtl-root .jtl-section-header__description {
    font-size: 12px;
    color: var(--jtl-text-secondary);
    margin-top: 2px;
    white-space: normal;
}

.jtl-root .jtl-section-header__actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.jtl-root .jtl-status-bar {
    flex-direction: row;
    align-items: center;
    height: 28px;
    min-height: 28px;
    padding: 0 24px;
    border-top-width: 1px;
    border-top-color: var(--jtl-border);
    background-color: var(--jtl-surface);
    flex-shrink: 0;
}

.jtl-root .jtl-status-bar__icon {
    margin-right: 8px;
}

.jtl-root .jtl-status-bar__text {
    font-size: 11px;
    color: var(--jtl-text-secondary);
}

.jtl-root .jtl-status-bar__spacer {
    flex-grow: 1;
}

.jtl-root .jtl-status-bar__time {
    font-size: 11px;
    color: var(--jtl-text-muted);
}

.jtl-root .jtl-segmented {
    flex-direction: row;
    height: 26px;
    min-height: 26px;
    border-width: 1px;
    border-color: var(--jtl-border);
    border-radius: 8px;
    flex-shrink: 0;
    overflow: hidden;
}

.jtl-root .jtl-segmented__option {
    padding: 0 9px;
    font-size: 11px;
    color: var(--jtl-text-secondary);
    -unity-text-align: middle-center;
    border-left-width: 1px;
    border-left-color: var(--jtl-border);
    transition-property: background-color, color;
    transition-duration: 0.1s;
}

.jtl-root .jtl-segmented__option--first {
    border-left-width: 0;
}

.jtl-root .jtl-segmented__option:hover {
    color: var(--jtl-text);
}

.jtl-root .jtl-segmented__option--selected {
    background-color: var(--jtl-accent-surface);
    color: var(--jtl-text);
}

.jtl-root .jtl-segmented--medium .jtl-segmented__option {
    padding: 0 12px;
    font-size: 12px;
}

.jtl-root .jtl-portal-mark {
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
}

.jtl-root .jtl-portal-mark--yandex {
    background-image: url("../Icons/Portals/yandex-games.png");
    -unity-background-scale-mode: scale-to-fit;
}

.jtl-root .jtl-portal-mark--youtube {
    background-image: url("../Icons/Portals/youtube-playables.png");
    -unity-background-scale-mode: scale-to-fit;
}

.jtl-root .jtl-swatch {
    padding-left: 6px;
    padding-right: 4px;
}

.jtl-root .jtl-swatch__color {
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin: 0 6px 0 0;
    flex-shrink: 0;
}

.jtl-root .jtl-swatch__color > .unity-base-field__input {
    min-height: 18px;
    height: 18px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--jtl-border-strong);
    border-radius: 4px;
    background-color: transparent;
    overflow: hidden;
}

.jtl-root .jtl-swatch__color .unity-color-field__color {
    border-radius: 3px;
}

.jtl-root .jtl-swatch__hex {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.jtl-root .jtl-swatch__hex > .unity-base-text-field__input {
    height: 28px;
    min-height: 28px;
    margin: 0;
    padding: 0 2px;
    border-width: 0;
    background-color: transparent;
    font-size: 12px;
    color: var(--jtl-text);
    white-space: nowrap;
    --unity-cursor-color: var(--jtl-text);
}

.jtl-root .jtl-picker {
    flex-grow: 1;
}

.jtl-root .jtl-picker__icon {
    margin-right: 6px;
}

.jtl-root .jtl-picker__value {
    font-size: 12px;
    color: var(--jtl-text);
    flex-grow: 1;
}

.jtl-root .jtl-picker__chevron {
    margin-left: 6px;
}

.jtl-root .jtl-picker:focus {
    border-color: var(--jtl-accent);
}

.jtl-root .jtl-table {
    flex-direction: column;
}

.jtl-root .jtl-table__row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    border-top-width: 1px;
    border-top-color: var(--jtl-border);
}

.jtl-root .jtl-table__row--head {
    border-top-width: 0;
}

.jtl-root .jtl-table__row--active {
    background-color: var(--jtl-row-active);
}

.jtl-root .jtl-table__row--dimmed {
    opacity: 0.45;
}

.jtl-root .jtl-table__heading {
    font-size: 11px;
    color: var(--jtl-text-muted);
}

.jtl-root .jtl-table__text {
    font-size: 13px;
    color: var(--jtl-text);
}

.jtl-root .jtl-table__cell {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-right: 12px;
}

.jtl-root .jtl-table__cell--grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.jtl-root .jtl-table__cell--last {
    margin-right: 0;
}

.jtl-root .jtl-pill {
    flex-direction: row;
    align-items: center;
    height: 26px;
    min-height: 26px;
    padding: 0 10px;
    border-width: 1px;
    border-color: var(--jtl-border);
    border-radius: 8px;
    background-color: var(--jtl-surface);
    flex-shrink: 0;
}

.jtl-root .jtl-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--jtl-accent);
    margin-right: 6px;
}

.jtl-root .jtl-pill__text {
    font-size: 11px;
    color: var(--jtl-text-secondary);
}

.jtl-root .jtl-chip {
    flex-direction: row;
    align-items: center;
    height: 26px;
    min-height: 26px;
    padding: 0 8px;
    border-width: 1px;
    border-color: var(--jtl-border);
    border-radius: 8px;
    background-color: var(--jtl-field-bg);
    flex-shrink: 0;
}

.jtl-root .jtl-chip__text {
    font-size: 11px;
    color: var(--jtl-text-secondary);
    margin-right: 6px;
}

.jtl-root .jtl-read-only {
    opacity: 0.4;
    background-color: var(--jtl-field-bg-disabled);
}

.jtl-root .jtl-read-only .jtl-portal-mark {
    margin-right: 6px;
}

.jtl-root .jtl-read-only__text {
    font-size: 13px;
    color: var(--jtl-text);
    flex-grow: 1;
    margin-right: 6px;
}

.jtl-root .jtl-code {
    padding: 10px 12px;
    border-width: 1px;
    border-color: var(--jtl-border);
    border-radius: 9px;
    background-color: var(--jtl-field-bg);
}

.jtl-root .jtl-code__text {
    font-size: 11px;
    color: var(--jtl-text-secondary);
    white-space: normal;
}

.jtl-root .jtl-preview {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    background-color: var(--jtl-bg);
    border-width: 1px;
    border-color: var(--jtl-border);
    border-radius: 10px;
}

.jtl-root .jtl-preview__logo {
    width: 96px;
    height: 96px;
    border-width: 1px;
    border-color: var(--jtl-border-strong);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
}

.jtl-root .jtl-preview__logo-text {
    font-size: 11px;
    color: var(--jtl-text-muted);
    -unity-text-align: middle-center;
}

.jtl-root .jtl-preview__track {
    width: 40%;
    height: 8px;
    background-color: var(--jtl-border);
    flex-direction: row;
    margin-bottom: 18px;
}

.jtl-root .jtl-preview__fill {
    width: 55%;
    height: 8px;
    background-color: var(--jtl-accent);
}

.jtl-root .jtl-preview__text {
    font-size: 12px;
    color: var(--jtl-text-secondary);
}

.jtl-root .jtl-slider {
    flex-grow: 1;
    margin: 0;
    min-height: 16px;
}

.jtl-root .jtl-slider > .unity-base-field__label {
    display: none;
}

.jtl-root .jtl-slider .unity-base-slider__input {
    min-height: 16px;
}

.jtl-root .jtl-slider .unity-base-slider__tracker {
    height: 4px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 2px;
    background-color: var(--jtl-border);
}

.jtl-root .jtl-slider .unity-base-slider__dragger {
    width: 12px;
    height: 12px;
    margin-top: -6px;
    border-width: 0;
    border-radius: 6px;
    background-color: var(--jtl-accent-strong);
}

.jtl-root .jtl-release {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 0;
}

.jtl-root .jtl-release__version {
    width: 130px;
    min-width: 130px;
    flex-direction: column;
    margin-right: 14px;
}

.jtl-root .jtl-release__notes {
    flex-grow: 1;
    flex-direction: column;
}

.jtl-root .jtl-release__note {
    flex-direction: row;
    align-items: flex-start;
}

.jtl-root .jtl-release__bullet {
    font-size: 12px;
    color: var(--jtl-text-muted);
    margin-right: 8px;
}

.jtl-root .jtl-release__text {
    font-size: 12px;
    color: var(--jtl-text-secondary);
    white-space: normal;
}

.jtl-root .jtl-module-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: var(--jtl-border);
}

.jtl-root .jtl-module-row--dimmed {
    opacity: 0.45;
}

.jtl-root .jtl-module-row__chevron {
    width: 16px;
    margin-right: 12px;
}

.jtl-root .jtl-module-row__name {
    width: 152px;
    min-width: 0;
    flex-shrink: 1;
    font-size: 13px;
    color: var(--jtl-text);
    margin-right: 12px;
}

.jtl-root .jtl-module-row__provider {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    max-width: 240px;
    min-width: 0;
    margin-right: 12px;
}

.jtl-root .jtl-module-row__note {
    flex-grow: 1;
    font-size: 11px;
    color: var(--jtl-text-muted);
}

.jtl-root .jtl-module-fields {
    flex-direction: column;
    padding: 10px 0 12px 28px;
}

.jtl-root .jtl-setting-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    padding-left: 28px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-top-width: 1px;
    border-top-color: var(--jtl-border);
}

.jtl-root .jtl-setting-row__name {
    width: 152px;
    min-width: 152px;
    font-size: 13px;
    color: var(--jtl-text);
    margin-right: 12px;
}

.jtl-root .jtl-setting-row__value {
    width: 240px;
    min-width: 240px;
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.jtl-root .jtl-setting-row__apply {
    width: 60px;
    min-width: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.jtl-root .jtl-setting-head {
    flex-direction: row;
    padding-left: 28px;
    align-items: center;
    height: 24px;
    min-height: 24px;
}

.jtl-root .jtl-setting-head__setting {
    width: 152px;
    min-width: 152px;
    margin-right: 12px;
}

.jtl-root .jtl-setting-head__value {
    width: 240px;
    min-width: 240px;
    margin-right: 12px;
}

.jtl-root .jtl-setting-head__apply {
    width: 60px;
    min-width: 60px;
    -unity-text-align: middle-right;
}

.jtl-root .jtl-setting-error {
    padding: 2px 0 6px 242px;
}

.jtl-root .jtl-finding-row {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    border-top-width: 1px;
    border-top-color: var(--jtl-border);
}

.jtl-root .jtl-finding-row--first {
    border-top-width: 0;
}

.jtl-root .jtl-finding-row__file {
    width: 210px;
    min-width: 210px;
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.jtl-root .jtl-finding-row__file .jtl-icon {
    margin-right: 6px;
}

.jtl-root .jtl-finding-row__call {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 12px;
    color: var(--jtl-text-secondary);
    margin-right: 12px;
}

.jtl-root .jtl-finding-row__arrow {
    width: 20px;
    min-width: 20px;
    margin-right: 12px;
}

.jtl-root .jtl-finding-row__replacement {
    flex-grow: 1;
    flex-basis: 0;
    font-size: 12px;
    color: var(--jtl-accent);
    margin-right: 12px;
}

.jtl-root .jtl-finding-row__actions {
    width: 150px;
    min-width: 150px;
    flex-direction: row;
    align-items: center;
}

.jtl-root .jtl-language-grid {
    flex-direction: row;
}

.jtl-root .jtl-language-column {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin-right: 16px;
}

.jtl-root .jtl-language-column--last {
    margin-right: 0;
}

.jtl-root .jtl-language-column .jtl-checkbox {
    height: 26px;
    min-height: 26px;
}

.jtl-root .jtl-mono,
.jtl-root .jtl-mono .unity-text-element,
.jtl-root .jtl-mono > .unity-base-text-field__input {
    font-size: 12px;
}

.jtl-root .jtl-configuration-grid {
    flex-direction: column;
}

.jtl-root .jtl-configuration-grid__row {
    margin-bottom: 12px;
}

.jtl-root .jtl-wrap {
    flex-wrap: wrap;
}

.jtl-root .jtl-language-check {
    width: 150px;
    margin-bottom: 8px;
}

.jtl-root .jtl-provider-fields .unity-base-field__label {
    color: var(--jtl-text-secondary);
    font-size: 12px;
    min-width: 190px;
}

.jtl-root .jtl-provider-fields .unity-base-field {
    margin: 0 0 6px 0;
}

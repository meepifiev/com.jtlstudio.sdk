}

.jtl-root .jtl-field > .unity-base-text-field__input {
    flex-grow: 1;
    white-space: nowrap;
    overflow: hidden;
    height: 30px;
    min-height: 30px;
    padding: 0 9px;
    margin: 0;
    border-radius: 9px;
    border-width: 1px;
    border-color: var(--jtl-border);
    background-color: var(--jtl-field-bg);
    font-size: 13px;
    color: var(--jtl-text);
    -unity-text-align: middle-left;
    --unity-cursor-color: var(--jtl-text);
    --unity-selection-color: var(--jtl-accent-border);
    transition-property: border-color, background-color;
    transition-duration: 0.1s;
}

.jtl-root .jtl-field > .unity-base-text-field__input:hover {
    border-color: var(--jtl-border-strong);
}

.jtl-root .jtl-field > .unity-base-text-field__input:focus {

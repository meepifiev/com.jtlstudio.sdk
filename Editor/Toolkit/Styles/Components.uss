}

.jtl-root .jtl-switch--on {
    background-color: var(--jtl-accent-strong);
    border-color: var(--jtl-accent-strong-border);
}

.jtl-root .jtl-switch--on .jtl-switch__knob {
    background-color: var(--jtl-text-on-accent);
    margin-left: 14px;
}

.jtl-root .jtl-switch--on:hover {
    border-color: var(--jtl-accent);
}

.jtl-root .jtl-switch:disabled {

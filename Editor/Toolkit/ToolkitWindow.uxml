<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:jtl="JTLStudio.SDK.Editor.Toolkit.Components">
    <ui:VisualElement name="root" class="jtl-root">
        <ui:VisualElement name="sidebar" class="jtl-sidebar">
            <ui:VisualElement class="jtl-sidebar__brand-spacer" />
            <ui:VisualElement class="jtl-sidebar__brand">
                <ui:VisualElement name="brand-logo" class="jtl-brand__logo" />
            </ui:VisualElement>
            <ui:ScrollView name="navigation" class="jtl-sidebar__nav" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement class="jtl-nav-group">
                    <jtl:NavigationItem section="Configurations" icon="configurations" text-key="nav.configurations" />
                    <jtl:NavigationItem section="Build" icon="build" text-key="nav.build" />
                    <jtl:NavigationItem section="Simulation" icon="simulation" text-key="nav.simulation" />
                    <jtl:NavigationItem section="Template" icon="template" text-key="nav.template" />
                </ui:VisualElement>
                <ui:VisualElement class="jtl-nav-separator" />
                <ui:VisualElement class="jtl-nav-group">
                    <jtl:NavigationItem section="PackageManager" icon="package" text-key="nav.packageManager" />
                    <jtl:NavigationItem section="Analyzer" icon="analyzer" text-key="nav.analyzer" />
                </ui:VisualElement>
                <ui:VisualElement class="jtl-nav-separator" />
                <jtl:LocalizedLabel key="nav.modules" class="jtl-nav-heading" />
                <jtl:NavigationCategory text-key="nav.configurable">
                    <ui:VisualElement class="jtl-nav-group">
                        <jtl:NavigationItem section="Purchases" icon="purchases" text-key="nav.purchases" />
                        <jtl:NavigationItem section="Saves" icon="saves" text-key="nav.saves" />
                        <jtl:NavigationItem section="Languages" icon="languages" text-key="nav.languages" />
                        <jtl:NavigationItem section="Leaderboards" icon="leaderboards" text-key="nav.leaderboards" />
                        <jtl:NavigationItem section="Flags" icon="flags" text-key="nav.flags" />
                    </ui:VisualElement>
                </jtl:NavigationCategory>
                <jtl:NavigationCategory text-key="nav.readyToUse">
                    <ui:VisualElement class="jtl-nav-group">
                        <jtl:NavigationItem section="Ads" icon="ads" text-key="nav.ads" />
                        <jtl:NavigationItem section="GameEvents" icon="gameplay" text-key="nav.gameEvents" />
                        <jtl:NavigationItem section="Pause" icon="pause" text-key="nav.pause" />
                        <jtl:NavigationItem section="Time" icon="clock" text-key="nav.time" />
                        <jtl:NavigationItem section="Audio" icon="audio" text-key="nav.audio" />
                        <jtl:NavigationItem section="Player" icon="player" text-key="nav.player" />
                        <jtl:NavigationItem section="Platform" icon="platform" text-key="nav.platform" />
                        <jtl:NavigationItem section="Review" icon="review" text-key="nav.review" />
                        <jtl:NavigationItem section="GameLabel" icon="shortcut" text-key="nav.gameLabel" />
                    </ui:VisualElement>
                </jtl:NavigationCategory>
            </ui:ScrollView>
            <ui:VisualElement class="jtl-sidebar__footer">
                <ui:VisualElement name="documentation-link" class="jtl-sidebar__link">
                    <jtl:Icon icon="documentation" />
                    <jtl:LocalizedLabel key="nav.documentation" class="jtl-sidebar__link-label" />
                </ui:VisualElement>
                <ui:VisualElement name="support-link" class="jtl-sidebar__link">
                    <jtl:Icon icon="support" />
                    <jtl:LocalizedLabel key="nav.support" class="jtl-sidebar__link-label" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="main" class="jtl-main">
            <ui:VisualElement name="top-bar" class="jtl-top-bar">
                <ui:VisualElement class="jtl-top-bar__spacer" />
                <ui:VisualElement name="package-pill-box" class="jtl-pill jtl-top-bar__pill">
                    <ui:VisualElement class="jtl-pill__dot" />
                    <ui:Label name="package-pill" text="" class="jtl-pill__text" />
                </ui:VisualElement>
                <jtl:SegmentedControl name="language-switch" choices="EN|RU" index="0" class="jtl-top-bar__language" />
            </ui:VisualElement>
            <ui:ScrollView name="content" class="jtl-content" mode="Vertical" horizontal-scroller-visibility="Hidden" />
            <jtl:StatusBar name="status-bar" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
